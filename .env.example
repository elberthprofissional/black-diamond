# =============================================================================
# BLACK DIAMOND — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env ou .env.local!
# =============================================================================

# ─── Supabase (OBRIGATÓRIO) ───
# URL do seu projeto Supabase + chave anônima (pública, pode ficar no frontend)
# Substitua pelos valores do SEU projeto Supabase.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# ─── Push Notifications (VAPID) ───
# Gere as chaves em: https://web-push-codelab.glitch.me/
# A chave PÚBLICA vai no .env (frontend).
# A chave PRIVADA vai como secret no Supabase (backend).
# Comando para setar a secret no Supabase:
#   supabase secrets set VAPID_PRIVATE_KEY=sua_chave_privada_aqui
#   supabase secrets set VAPID_PUBLIC_KEY=sua_chave_publica_aqui
# Substitua pela chave PÚBLICA gerada no link acima.
VITE_VAPID_PUBLIC_KEY=sua_chave_vapid_publica_aqui

# ─── Sentry (Monitoramento de Erros — OPCIONAL) ───
# Crie uma conta em: https://sentry.io/
# Crie um projeto React e copie o DSN aqui.
VITE_SENTRY_DSN=

# ─── Google Analytics (Opcional) ───
# Crie uma propriedade em: https://analytics.google.com/
VITE_GA_ID=

# ─── URL do Site (para templates de WhatsApp) ───
VITE_SITE_URL=https://black-diamond-wheat.vercel.app

# ─── WhatsApp do Barbeiro (para templates) ───
VITE_BARBER_WHATSAPP=

# ─── Supabase Service Role Key (somente para SCRIPTS locais) ───
# NUNCA coloque esta chave no frontend ou no código. Só os scripts em scripts/*.mjs usam.
# Pegue em: Supabase Dashboard > Project Settings > API > service_role
# ⚠️ Se esta chave já foi commitada no git, ROTACIONE-A no Supabase.
SUPABASE_SERVICE_KEY=

# ─── Supabase Publishable Key (para scripts de auditoria) ───
# Usada pelo modo `node scripts/audit-360.mjs keys` para testar a chave
# publishable atual (a que está publicada em produção). Publishable é
# semi-pública por design, mas nunca hardcode no código — ela rotaciona.
# Pegue em: Supabase Dashboard > Project Settings > API
SUPABASE_PUBLISHABLE_KEY=

# ─── Supabase Service Role Key (para Edge Functions) ───
# Necessário para as Edge Functions escreverem no banco.
# Configurar como secret no Supabase, NÃO no .env!
# SUPABASE_SERVICE_ROLE_KEY=
