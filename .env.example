# Copie para .env e preencha com os valores do seu projeto Supabase.
# NUNCA versionar o arquivo .env real.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY

# ------------------------------------------------------------------
# Apenas para desenvolvimento local (scripts em /scripts).
# NUNCA coloque a service role key no frontend.
# ------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

# Credenciais usadas pelo seed/dev (dev-only).
SEED_OWNER_EMAIL=joao@blackdiamond.local
SEED_OWNER_PASSWORD=joao@2026
SEED_BARBER_EMAILS='["carlos@blackdiamond.local","pedro@blackdiamond.local"]'
